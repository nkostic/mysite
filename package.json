{
  "name": "nenad-kostic-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm run lexicons:check",
    "lexicons:check": "node scripts/validate-lexicons.mjs",
    "search:index": "node scripts/index-algolia.mjs",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "devDependencies": {
    "@atproto/lexicon": "0.7.12",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "22.19.19",
    "lighthouse": "13.4.1",
    "mdsvex": "0.12.8",
    "svelte": "5.56.10",
    "svelte-check": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.165.0"
  },
  "dependencies": {
    "@atproto/api": "0.20.41",
    "@atproto/oauth-client-browser": "0.5.2",
    "@icons-pack/svelte-simple-icons": "7.2.0"
  }
}
